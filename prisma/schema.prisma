// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
  DOSEN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique // NIM for student, or admin username
  email     String?  @unique // For Google SSO
  password  String
  foto      String?
  role      Role     @default(STUDENT)
  mahasiswa Mahasiswa?
  dosen     Dosen?
  createdAt DateTime @default(now())
}

model Mahasiswa {
  id           String    @id @default(uuid())
  nim          String    @unique
  nama         String
  foto         String?   @default("https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=400&h=400&fit=crop")
  kontak       String?
  peminatan    String?
  bio          String?
  ipk          Float?
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  kelompokId   String?
  kelompok     Kelompok? @relation(fields: [kelompokId], references: [id])
  isLeader     Boolean   @default(false)
  sentInvites  Invitation[] @relation("SentInvites")
  receivedInvites Invitation[] @relation("ReceivedInvites")
}

model Kelompok {
  id           String    @id @default(uuid())
  nama         String?
  mahasiswa    Mahasiswa[]
  dosenId      String?
  dosen        Dosen?    @relation(fields: [dosenId], references: [id])
  invitations  Invitation[]
  createdAt    DateTime  @default(now())
}

model Invitation {
  id           String           @id @default(uuid())
  kelompokId   String
  kelompok     Kelompok         @relation(fields: [kelompokId], references: [id])
  fromId       String
  from         Mahasiswa        @relation("SentInvites", fields: [fromId], references: [id])
  toId         String
  to           Mahasiswa        @relation("ReceivedInvites", fields: [toId], references: [id])
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
}

model Dosen {
  id          String   @id @default(uuid())
  nama        String
  foto        String?  @default("https://images.unsplash.com/photo-1544717297-fa154da09f9b?w=400&h=400&fit=crop")
  nip         String   @unique
  keahlian    String?  @default("Pendidikan Teknologi Informasi")
  bio         String?  @default("Dosen tetap di Program Studi Pendidikan Teknologi Informasi UNESA dengan fokus pada pengembangan sistem dan metodologi pembelajaran berbasis teknologi.")
  pendidikan  String?  @default("S1 Pendidikan Teknologi Informasi - UNESA; S2 Teknik Informatika - ITS")
  publikasi   String?  @default("Pengembangan Sistem E-Learning Berbasis Gamifikasi (2023); Implementasi AI dalam Media Pembelajaran (2022)")
  kontak      String?
  kuotaMax    Int      @default(5)
  kelompok    Kelompok[]
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model WarConfig {
  id        String   @id @default("global_config")
  startTime DateTime
  endTime   DateTime
}
