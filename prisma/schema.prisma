// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
  DOSEN
  DEVELOPER
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique // NIM for student, or admin username
  email     String?  @unique // For Google SSO
  password  String
  foto      String?
  role      Role     @default(STUDENT)
  mahasiswa Mahasiswa?
  dosen     Dosen?
  createdAt DateTime @default(now())
}

model Mahasiswa {
  id           String    @id @default(uuid())
  nim          String    @unique
  nama         String
  foto         String?   @default("https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=400&h=400&fit=crop")
  kontak       String?
  peminatan    String?
  bio          String?
  angkatan     String?
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  dosenId         String?
  dosen           Dosen?    @relation(fields: [dosenId], references: [id])
  rencanaJudul    String?
  magangPosisi    String?
  magangTempat    String?
  plpLokasi       String?
  statusBimbingan String    @default("PENDING")
  periode         String?
  updatedAt       DateTime  @default(now()) @updatedAt
  selectedAt      DateTime?
}

model Dosen {
  id          String   @id @default(uuid())
  nama        String
  foto        String?  @default("https://images.unsplash.com/photo-1544717297-fa154da09f9b?w=400&h=400&fit=crop")
  nip         String   @unique
  keahlian    String?  @default("Pendidikan Teknologi Informasi")
  bio         String?  @default("Dosen tetap di Program Studi Pendidikan Teknologi Informasi UNESA dengan fokus pada pengembangan sistem dan metodologi pembelajaran berbasis teknologi.")
  moto        String?  @default("Mendidik dengan hati, membangun masa depan dengan teknologi.")
  pendidikan  String?  @default("S1 Pendidikan Teknologi Informasi - UNESA; S2 Teknik Informatika - ITS")
  publikasi   String?  @default("Pengembangan Sistem E-Learning Berbasis Gamifikasi (2023); Implementasi AI dalam Media Pembelajaran (2022)")
  kontak      String?
  kuotaMax    Int      @default(5)
  mahasiswa   Mahasiswa[]
  penelitian  Penelitian[]
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Penelitian {
  id          String   @id @default(uuid())
  judul       String
  isActive    Boolean  @default(true)
  dosenId     String
  dosen       Dosen    @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

enum StatusBimbingan {
  PENDING
  APPROVED
  REJECTED
}

enum WarCategory {
  MAGANG
  PLP
  SKRIPSI_ARTIKEL
}

model WarConfig {
  id        String   @id @default("global_config")
  startTime DateTime
  endTime   DateTime
  periode        String?  @default("Genap 2024/2025")
  targetAngkatan String?  @default("All")
  announcement   String?
  isForcedClosed Boolean  @default(false)
  category       WarCategory @default(SKRIPSI_ARTIKEL)
}

enum DocumentCategory {
  MOA
  IA
  PROPOSAL_MAGANG
  SURAT_PERNYATAAN_BERDAMPAK
  TEMPLATE_LAPORAN_AKHIR_MAGANG
  TEMPLATE_MOA_IA_MOBILITAS_AKADEMIK
  OTHER
}

model AcademicDocument {
  id          String           @id @default(uuid())
  title       String
  description String?
  category    DocumentCategory
  fileUrl     String?          // URL Supabase / file lokal
  driveUrl    String?          // URL Google Drive / external link
  fileType    String?          // e.g. "pdf", "docx", "link"
  fileSize    Int?             // Ukuran file dalam bytes
  uploadedBy  String           // Username/NIM admin yang upload
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ActivityLog {
  id           String   @id @default(uuid())
  actionType   String   // "SELECT", "ASSIGN", "CANCEL", "SWAP", "RESET"
  studentName  String?
  studentNim   String?
  lecturerName String?
  studentName2 String?
  studentNim2  String?
  timestamp    DateTime @default(now())
}

